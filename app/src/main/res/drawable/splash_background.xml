<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Splash background: deep cyber slate (splash_colors.xml) -->
    <item android:drawable="@color/splash_bg" />

    <!-- Centered LimitX mark -->
    <item
        android:gravity="center"
        android:width="200dp"
        android:height="200dp"
        android:drawable="@drawable/limitx_logo" />

    <!-- Transparent wordmark spacer to prevent crashes -->
    <item
        android:gravity="bottom|center_horizontal"
        android:width="200dp"
        android:height="80dp"
        android:bottom="60dp"
        android:drawable="@drawable/splash_wordmark" />
</layer-list>
