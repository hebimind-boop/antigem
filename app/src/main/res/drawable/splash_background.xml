<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Splash background: deep cyber slate (splash_colors.xml) -->
    <item android:drawable="@color/splash_bg" />

    <!-- Centered circular LimitX logo mark -->
    <item
        android:gravity="center"
        android:width="170dp"
        android:height="170dp"
        android:bottom="50dp"
        android:drawable="@drawable/limitx_logo" />

    <!-- LimitX brand title wordmark placed directly beneath logo -->
    <item
        android:gravity="center"
        android:width="200dp"
        android:height="50dp"
        android:top="170dp"
        android:drawable="@drawable/splash_wordmark" />
</layer-list>
